# Vibe-Trading local configuration
# Generated automatically for local MT5/OpenRouter setup.

# --- LLM Provider (OpenRouter) ---
LANGCHAIN_PROVIDER=openrouter
LANGCHAIN_MODEL_NAME=nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=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
#   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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Output-token ceiling. OpenRouter bills against the requested ceiling on
# free tiers, so an unset value (the model's full max output) can be
# rejected with HTTP 402 even when the prompt is affordable.
LANGCHAIN_MAX_TOKENS=4000

# --- Jev (TypeSafe AI) - structured fast decisions ---
# Jev rides the same OpenRouter gateway + key as the LLM.
JEV_BASE_URL=https://openrouter.ai/api/v1
# Jev router antigo (chat completions). Reverter removendo JEV_PROTOCOL e descomentando:
# JEV_MODEL=typesafe/jev-router
JEV_MODEL=inception/mercury-decide:free
JEV_PROTOCOL=decisions
# Jev as a pre-trade ADVISORY provider in the order guard (observational:
# the verdict lands in the audit trail, it does not block the order).
# Requires VIBE_TRADING_ENABLE_ADVISORY=1 as well.
VIBE_TRADING_ENABLE_ADVISORY=1
JEV_ADVISORY=1

# Let a confident Jev "unacceptable risk" verdict BLOCK an order.
# Off by default: the mandate gate is the sole allow/deny authority.
# JEV_ORDER_GUARD=1

# Threshold: minimum probability Jev must assign to "risk is acceptable"
# before the order is blocked (only used when JEV_ORDER_GUARD=1).
JEV_RISK_MIN_PROB=0.4

# Let a confident Jev "do not trade" verdict skip the live runner's agent call.
# Off by default (advisory only).
# JEV_LIVE_VETO=1

# --- Autonomous operation ---
# Enables the scheduled-research executor: cron / interval-driven agent runs.
# Each fire creates a session and runs the agent with the configured tools
# (see ~/.vibe-trading/agent.json -> enabledTools), so the agent can trade the
# MT5 demo account on its own. Jobs are created via POST /scheduled-runs.
VIBE_TRADING_ENABLE_SCHEDULER=1
